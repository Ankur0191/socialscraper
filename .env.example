# Supabase: server-side only. Prefer scoped keys when possible.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Add only after official X API access is purchased/configured.
# X_BEARER_TOKEN=
SOCIALSCRAPER_HEADLESS=false
SOCIALSCRAPER_PAGE_TIMEOUT_MS=30000
SOCIALSCRAPER_MAX_PAGES_PER_RUN=30

# Optional vision-based interpretation of public images/poster frames.
# Configure a separately billed OpenAI API key only if you want to run analyze-media.
# OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.4-mini
